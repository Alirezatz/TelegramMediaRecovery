<Window x:Class="TelegramMediaRecovery.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Media Recovery" Width="1440" Height="920" MinWidth="1120" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F2F5F9"
        FontFamily="Segoe UI" Language="en-US" FontSize="13" Foreground="#243247">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE6EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,16,0,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#287EB4" />
            <Setter Property="Padding" Value="5,5" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderBrush" Value="#E8EDF4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF4FD" />
                    <Setter Property="Foreground" Value="#243247" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Telegram Media Recovery" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Recover cached media. Browse first, then export your selection." Foreground="#718096" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#59728D" FontSize="12"
                       Text="01  Source     →     02  Scan     →     03  Browse and preview     →     04  Export" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Source" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" x:Name="SourcePathBox" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding DetectedSources}"
                          Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditSource}"
                          ToolTip="Choose tdata, a cache snapshot or the Telegram Desktop directory." Margin="0,0,10,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" IsEnabled="{Binding CanEditSource}">
                    <Button Content="Choose folder..." Click="OnBrowseSource" />
                    <Button Content="Find local data" Command="{Binding FindSourcesCommand}" Margin="0,0,16,0" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="Local passcode" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="0,0,8,0" />
                <PasswordBox Grid.Column="4" x:Name="PasscodeBox" Width="125" Height="32" Margin="0,0,16,0"
                             PasswordChanged="OnPasscodeChanged" IsEnabled="{Binding CanEditSource}" ToolTip="Leave empty if no local passcode is set." />
                <Button Grid.Column="5" Content="Scan media" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding CatalogSummary}"
                           Foreground="#718096" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200" MaxWidth="360" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" /><ColumnDefinition Width="350" MinWidth="280" MaxWidth="640" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource SubtleButton}" Command="{Binding ResetFiltersCommand}" Margin="0" />
                            <TextBlock Text="Filter media" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Search" Style="{StaticResource FilterLabel}" />
                        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=200}" MinHeight="32" ToolTip="Search generated names, formats or cache keys (Ctrl+F)." />
                        <TextBlock Text="Cache usage" Style="{StaticResource FilterLabel}" />
                        <ComboBox ItemsSource="{Binding Usages}" SelectedItem="{Binding UsageFilter}"
                                  ToolTip="Classify by Telegram cache markers. Hiding avatars and thumbnails keeps files with unknown usage." />
                        <TextBlock Text="Media type" Style="{StaticResource FilterLabel}" />
                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindFilter}" />
                        <TextBlock Text="Verification" Style="{StaticResource FilterLabel}" />
                        <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding StateFilter}" />
                        <TextBlock Text="Known file size" Style="{StaticResource FilterLabel}" />
                        <TextBox Text="{Binding MinimumSize, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Minimum size, such as 16KB. Leave empty for no limit." MinHeight="32" />
                        <TextBlock Text="to" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,2" />
                        <TextBox Text="{Binding MaximumSize, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="Maximum size, such as 100MB. Leave empty for no limit." MinHeight="32" />
                        <TextBlock Text="Estimated cache date" Style="{StaticResource FilterLabel}" />
                        <DatePicker SelectedDate="{Binding DateFrom}" ToolTip="Start date" MinHeight="30" />
                        <TextBlock Text="to" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,2" />
                        <DatePicker SelectedDate="{Binding DateTo}" ToolTip="End date" MinHeight="30" />
                        <TextBlock Text="{Binding FilterError}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" />
                        <Border Background="#F2F7FC" CornerRadius="6" Padding="10" Margin="0,20,0,0">
                            <TextBlock Text="Cache dates are estimates. A stream's original length and completeness may be unknown." Foreground="#64809B" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#E3EAF2" ShowsPreview="True" ResizeBehavior="PreviousAndNext" ToolTip="Resize filters" />
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#E3EAF2" ShowsPreview="True" ResizeBehavior="PreviousAndNext" ToolTip="Resize preview" />

            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultsTitle}" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="Check results" Command="{Binding SelectVisibleCommand}" Style="{StaticResource SubtleButton}" FontSize="12" />
                                <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SubtleButton}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Width="190" VerticalAlignment="Top" />
                    </Grid>
                    <DataGrid Grid.Row="1" x:Name="MediaGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding CurrentItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                              RowHeight="82" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF1F6" BorderThickness="0" Background="White" AlternatingRowBackground="#FCFDFF"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsEnabled="{Binding DataContext.CanEditSource, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Preview" Width="74">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border Width="60" Height="60" Background="#EEF3F9" CornerRadius="6" Loaded="OnMediaRowLoaded" Unloaded="OnMediaRowUnloaded" DataContextChanged="OnMediaRowContextChanged" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Icon}" Foreground="#8DA5BC" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Media" Width="*" MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Usage}" Foreground="#537D98" FontSize="11" Margin="0,4,0,0" ToolTip="{Binding UsageDescription}" />
                                        <TextBlock Text="{Binding Source}" Foreground="#8A9AAF" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Size" Width="88">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Size}" VerticalAlignment="Center" Margin="6,0" Foreground="#53667E" />
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="State" Width="136">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Border Background="#EFF6FA" CornerRadius="5" Padding="7,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="#537D98" />
                                    </Border>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" Foreground="#94A3B8" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280" TextAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding VisibleCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16" SizeChanged="OnPreviewPaneSizeChanged">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentItem.Name, TargetNullValue=Media preview}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Source message not linked · Saving restrictions unknown" Foreground="#8A9BAE" FontSize="10" Margin="0,5,0,0"
                                   Visibility="{Binding HasCurrentItem, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="{Binding CurrentItem.UsageDescription}" Foreground="#647D94" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasCurrentItem, Converter={StaticResource BoolVisibility}}" />
                        <Border x:Name="PreviewSurface" Height="250" Background="#F3F6FA" CornerRadius="8" Margin="0,13,0,12" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="Select an item to preview" Foreground="#9AAFC3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCurrentItem}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8" />
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                                              MediaFailed="OnMediaFailed" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded"
                                              Visibility="{Binding HasMediaPreview, Converter={StaticResource BoolVisibility}}" />
                            </Grid>
                        </Border>
                        <StackPanel Visibility="{Binding HasMediaPreview, Converter={StaticResource BoolVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Play" Click="OnPlay" /><Button Content="Pause" Click="OnPause" />
                                <Button Content="Open externally" Click="OnOpenPreview" Style="{StaticResource SubtleButton}" />
                            </StackPanel>
                            <Slider x:Name="Seek" Minimum="0" Maximum="1" ValueChanged="OnSeek" Margin="0,6,0,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewMessage}" Foreground="#718096" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                        <Border Background="#F8FAFC" CornerRadius="7" Padding="12" Visibility="{Binding HasCurrentItem, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding CurrentDetails}" TextWrapping="Wrap" LineHeight="26" Foreground="#597087" FontSize="12" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectionSummary}" ToolTip="{Binding SelectionSummary}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Each export creates a new folder. The data source stays read-only." Foreground="#8293A7" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="Open export folder" Command="{Binding OpenOutputCommand}" />
                    <Button x:Name="ExportCheckedButton" Content="Export checked..." Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Margin="0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" BorderThickness="0" Background="#ECF1F7" Foreground="#2AABEE" />
                    <TextBlock Text="{Binding Status}" Foreground="#6D8096" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                </StackPanel>
            </Grid>
        </Border>
        <Expander Grid.Row="4" Header="Activity log" Margin="2,9,0,0" Foreground="#7B8DA2" FontSize="11">
            <ListBox ItemsSource="{Binding Log}" MaxHeight="120" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11" />
        </Expander>
    </Grid>
</Window>
