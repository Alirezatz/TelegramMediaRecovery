<Window x:Class="TelegramMediaRecovery.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telegram Media Recovery"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#EEF1F4">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitle}" Text="Telegram Media Recovery" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Read-only recovery of cached media from a Telegram Desktop / 64Gram Desktop tdata folder. Nothing inside tdata is ever modified." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== settings ===================== -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#D9DEE4" BorderThickness="1" Padding="14" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="SOURCE" />
                        <TextBlock Style="{StaticResource Hint}" Text="tdata folder" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TdataPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Click="OnBrowseTdata" />
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Text="Local passcode (empty when none is set)" Margin="0,10,0,3" />
                        <PasswordBox x:Name="PasscodeBox" />

                        <TextBlock Style="{StaticResource Hint}" Text="Output folder" Margin="0,10,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Click="OnBrowseOutput" />
                        </Grid>

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="DATABASES" />

                        <CheckBox Content="cache  (photos, GIFs, stickers)" IsChecked="{Binding IncludeCache}" />
                        <CheckBox Content="media_cache  (streamed video and audio)" IsChecked="{Binding IncludeMediaCache}" />

                        <TextBlock Style="{StaticResource Hint}" Text="Only these accounts (comma separated, empty = all)" Margin="0,10,0,3" />
                        <TextBox Text="{Binding Accounts, UpdateSourceTrigger=PropertyChanged}" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="FILTERS" />

                        <TextBlock Style="{StaticResource Hint}" Text="Smallest file, e.g. 4KB" Margin="0,0,0,3" />
                        <TextBox Text="{Binding MinimumSize, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Hint}" Text="Largest file, e.g. 2GB" Margin="0,10,0,3" />
                        <TextBox Text="{Binding MaximumSize, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,10,0,3"
                                   Text="Minimum share of a streamed file that must be cached" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <!--
                                Slider.Value and ProgressBar.Value both default to a
                                two-way binding, which WPF refuses on a read-only
                                property. One-way is what a progress display wants
                                anyway: the view model pushes, the view never writes back.
                            -->
                            <Slider Grid.Column="0" Minimum="0" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding MinimumCoverage, Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding MinimumCoverage, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="EXTRA WORK" />

                        <CheckBox Content="Also recover unreferenced files" IsChecked="{Binding ScanOrphans}" />
                        <CheckBox Content="Hash and remove duplicates" IsChecked="{Binding ComputeHashes}" />
                        <CheckBox Content="Keep unrecognised content as .bin" IsChecked="{Binding KeepUnknown}" />
                        <CheckBox Content="Mark incomplete files .partial" IsChecked="{Binding MarkPartials}" />
                        <CheckBox Content="Require the header slice" IsChecked="{Binding RequireStreamHeader}" />
                        <CheckBox Content="Date-prefix file names" IsChecked="{Binding DatedNames}" />
                        <CheckBox Content="Write HTML gallery" IsChecked="{Binding WriteHtmlReport}" />
                        <CheckBox Content="Write manifest.json" IsChecked="{Binding WriteJsonManifest}" />
                        <CheckBox Content="Verbose log" IsChecked="{Binding Verbose}" />

                        <TextBlock Style="{StaticResource Hint}" Text="Worker threads (0 = one per CPU)" Margin="0,10,0,3" />
                        <TextBox Text="{Binding Threads, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================== right pane ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource PrimaryButton}" Content="Start recovery" Click="OnStart" />
                    <Button Content="Inspect folder" Click="OnScan" />
                    <Button Content="Cancel" Click="OnCancel" />
                    <Button Content="Open output" Click="OnOpenOutput" />
                    <Button Content="Open report" Click="OnOpenReport" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <ProgressBar Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Hint}" Text="{Binding Status}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}"
                                   Text="{Binding BytesWritten, StringFormat=written {0}}" />
                    </Grid>
                </StackPanel>

                <TabControl Grid.Row="2" Background="White" BorderBrush="#D9DEE4">
                    <TabItem Header="Activity">
                        <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Background="White"
                                 FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="NoWrap" Margin="8,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem Header="Databases">
                        <DataGrid ItemsSource="{Binding Databases}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                  BorderThickness="0" Background="White" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="200" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" />
                                <DataGridTextColumn Header="Live entries" Binding="{Binding Entries}" Width="110" />
                                <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="90" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                                <DataGridTextColumn Header="Warnings" Binding="{Binding Warnings}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Summary">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Summary}" FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="12" Margin="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>