<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TelegramMediaRecovery.Core</RootNamespace>
    <AssemblyName>TelegramMediaRecovery.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TelegramMediaRecovery.Core</PackageId>
    <Description>
      Read-only reader for Telegram Desktop / 64Gram Desktop "tdata" folders:
      local-key derivation, TDEF container decryption, cache-binlog parsing and
      reconstruction of cached media files.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TelegramMediaRecovery.Core.Tests" />
  </ItemGroup>

</Project>